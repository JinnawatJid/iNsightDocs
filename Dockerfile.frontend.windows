# Stage 1: Build the Vue application
FROM mcr.microsoft.com/windows/servercore:ltsc2019 AS build-stage

# Set shell to PowerShell
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Copy local Node.js zip (Must be in build context)
COPY nodejs.zip C:/nodejs.zip

# Install Node.js from local zip
RUN Expand-Archive C:\nodejs.zip -DestinationPath C:\; \
    Rename-Item "C:\node-v18.19.0-win-x64" c:\nodejs; \
    Remove-Item C:\nodejs.zip

# Add Node.js to PATH
RUN $env:PATH = 'C:\nodejs;' + $env:PATH; \
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH, [EnvironmentVariableTarget]::Machine)

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the application
FROM mcr.microsoft.com/windows/servercore:ltsc2019 AS production-stage

# Set shell to PowerShell
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Copy local Node.js zip (Must be in build context)
COPY nodejs.zip C:/nodejs.zip

# Install Node.js from local zip
RUN Expand-Archive C:\nodejs.zip -DestinationPath C:\; \
    Rename-Item "C:\node-v18.19.0-win-x64" c:\nodejs; \
    Remove-Item C:\nodejs.zip

# Add Node.js to PATH
RUN $env:PATH = 'C:\nodejs;' + $env:PATH; \
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH, [EnvironmentVariableTarget]::Machine)

WORKDIR /app

# Install express and http-proxy-middleware for the static server
RUN npm install express http-proxy-middleware

# Copy the static server script
COPY static-server.js .

# Copy the built assets from the build stage
COPY --from=build-stage /app/dist ./dist

# Expose port 80
EXPOSE 80

# Start the static server
CMD ["node", "static-server.js"]
