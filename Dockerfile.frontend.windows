# Stage 1: Build the Vue application
FROM node:18-windowsservercore-1809 AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the application using a lightweight Node.js server
FROM node:18-windowsservercore-1809 AS production-stage
WORKDIR /app

# Install express and http-proxy-middleware for the static server
RUN npm install express http-proxy-middleware

# Copy the static server script
COPY static-server.js .

# Copy the built assets from the build stage
COPY --from=build-stage /app/dist ./dist

# Expose port 80
EXPOSE 80

# Start the static server
CMD ["node", "static-server.js"]
