{
  "version": "1.0",
  "description": "Credit Scoring Model V1 - New Customer Strategy",
  "components": {
    "C1": {
      "label": "Company Strength",
      "factors": {
        "yearsInBusiness": {
          "label": "ระยะเวลาธุรกิจ (Years in Business)",
          "weight": 14.42,
          "rules": [
            { "min": 10, "score": 2.0, "label": "Established (> 10 Years)" },
            { "min": 5, "max": 10, "score": 1.5, "label": "Stable (5 - 10 Years)" },
            { "min": 3, "max": 5, "score": 1.0, "label": "Growing (3 - 5 Years)" },
            { "min": 1, "max": 3, "score": 0.5, "label": "New (1 - 3 Years)" },
            { "max": 1, "score": 0.25, "label": "Entry (< 1 Year)" }
          ]
        },
        "leverage": {
          "label": "สัดส่วนเครดิตที่ขอต่อทุนจดทะเบียน (Request / Registered Capital)",
          "weight": 8.64,
          "rules": [
            { "max": 0.5, "score": 2.0, "label": "Low Leverage (<= 0.5x)" },
            { "min": 0.5, "max": 0.9, "score": 1.5, "label": "Moderate Leverage (0.5x - 0.9x)" },
            { "min": 0.9, "max": 1.5, "score": 1.0, "label": "Standard Leverage (0.9x - 1.5x)" },
            { "min": 1.5, "max": 1.99, "score": 0.5, "label": "High Leverage (1.5x - 1.99x)" },
            { "min": 1.99, "score": 0.25, "label": "Very High Leverage (> 1.99x)" }
          ]
        },
        "assetOwnership": {
          "label": "กรรมสิทธิ์ทรัพย์สิน (Asset Ownership)",
          "weight": 25.94,
          "rules": [
            { "match": ["ตนเอง", "Own"], "score": 2.0, "label": "Owned (Self)" },
            { "match": ["ญาติ", "บิดามารดา", "Relative", "Parents"], "score": 1.5, "label": "Owned (Family)" },
            { "match": ["เช่า", "Rent"], "score": 1.0, "label": "Rented" },
            { "default": true, "score": 1.0, "label": "Other" }
          ]
        }
      }
    },
    "C2": {
      "label": "Financial Status",
      "factors": {
        "deRatio": {
          "label": "อัตราส่วนหนี้สินรวมต่อส่วนของผู้ถือหุ้น (D/E Ratio)",
          "weight": 24.76,
          "rules": [
            { "max": 1, "score": 2.0, "label": "Excellent (<= 1.0)" },
            { "min": 1, "max": 1.5, "score": 1.6, "label": "Good (1.0 - 1.5)" },
            { "min": 1.5, "max": 2, "score": 1.2, "label": "Fair (1.5 - 2.0)" },
            { "min": 2, "max": 3, "score": 1.0, "label": "Weak (2.0 - 3.0)" },
            { "min": 3, "score": 0.0, "label": "Poor (> 3.0)" }
          ]
        },
        "inventoryTurnover": {
          "label": "อัตราการหมุนเวียนของสินค้าคงเหลือ (Inventory Turnover)",
          "weight": 13.76,
          "rules": [
            { "min": 12, "score": 2.0, "label": "Excellent (>= 12)" },
            { "min": 8, "max": 12, "score": 1.5, "label": "Good (8 - 12)" },
            { "min": 6, "max": 8, "score": 1.0, "label": "Fair (6 - 8)" },
            { "min": 4, "max": 6, "score": 0.5, "label": "Weak (4 - 6)" },
            { "max": 4, "score": 0.0, "label": "Poor (< 4)" }
          ]
        },
        "dscr": {
          "label": "ความสามารถในการชำระหนี้ (DSCR)",
          "weight": 16.50,
          "rules": [
            { "min": 0.5, "score": 2.0, "label": "Strong (>= 0.5)" },
            { "min": 0.4, "max": 0.5, "score": 1.5, "label": "Good (0.4 - 0.5)" },
            { "min": 0.33, "max": 0.4, "score": 1.0, "label": "Fair (0.33 - 0.4)" },
            { "min": 0.25, "max": 0.33, "score": 0.5, "label": "Weak (0.25 - 0.33)" },
            { "max": 0.25, "score": 0.0, "label": "Critical (< 0.25)" }
          ]
        }
      }
    },
    "C3": {
      "label": "Purchase Behavior",
      "factors": {
        "revenueCapitalRatio": {
          "label": "สัดส่วนรายได้ต่อทุนจดทะเบียน (Revenue / Capital)",
          "weight": 3.04,
          "rules": [
            { "min": 1.5, "score": 2.0, "label": "High (>= 1.5)" },
            { "min": 1.0, "max": 1.5, "score": 1.5, "label": "Good (1.0 - 1.5)" },
            { "min": 0.6, "max": 1.0, "score": 1.0, "label": "Fair (0.6 - 1.0)" },
            { "min": 0.26, "max": 0.6, "score": 0.5, "label": "Low (0.26 - 0.6)" },
            { "max": 0.26, "score": 0.25, "label": "Minimal (< 0.26)" }
          ]
        },
        "capacityCheck": {
          "label": "สัดส่วนยอดซื้อเฉลี่ย 3 เดือนต่อเครดิตที่ขอ (Capacity)",
          "weight": 35.04,
          "rules": [
            { "max": 0.25, "score": 0.25, "label": "Too Low (<= 0.25)" },
            { "min": 0.25, "max": 0.59, "score": 0.5, "label": "Low (0.25 - 0.59)" },
            { "min": 0.59, "max": 0.99, "score": 1.0, "label": "Standard (0.59 - 0.99)" },
            { "min": 0.99, "max": 1.49, "score": 1.5, "label": "High (0.99 - 1.49)" },
            { "min": 1.49, "max": 1.50, "score": 2.0, "label": "Excellent (>= 1.5)" },
             { "min": 1.5, "score": 0.25, "label": "Over Limit (> 1.5)" }
          ]
        },
        "turnoverSpeed": {
          "label": "สัดส่วนยอดซื้อต่อระยะเวลาเครดิตที่ขอ (Turnover Speed)",
          "weight": 18.28,
          "rules": [
            { "max": 0.5, "score": 0.5, "label": "Slow (<= 0.5)" },
            { "min": 0.5, "max": 0.9, "score": 1.0, "label": "Standard (0.5 - 0.9)" },
            { "min": 0.9, "max": 1.5, "score": 1.5, "label": "Fast (0.9 - 1.5)" },
            { "min": 1.5, "score": 2.0, "label": "Very Fast (> 1.5)" }
          ]
        },
        "purchaseTrend": {
          "label": "แนวโน้มการซื้อ (Slope)",
          "weight": 28.96,
          "rules": [
            { "min": 16008.34, "score": 2.0, "label": "Rapid Growth (> 16k)" },
            { "min": 205.52, "max": 16008.34, "score": 1.5, "label": "Growth (205 - 16k)" },
            { "min": -0.01, "max": 205.52, "score": 1.0, "label": "Stable (-0.01 - 205)" },
            { "min": -4654.54, "max": -0.01, "score": 0.5, "label": "Decline (-4.6k - 0)" },
            { "max": -4654.54, "score": 0.25, "label": "Sharp Decline (< -4.6k)" }
          ]
        },
        "customerDuration": {
          "label": "ระยะเวลาเป็นลูกค้า (Customer Duration)",
          "weight": 10.66,
          "rules": [
            { "min": 7, "score": 2.0, "label": "Loyal (> 7 Years)" },
            { "min": 4, "max": 7, "score": 1.5, "label": "Established (4 - 7 Years)" },
            { "min": 2, "max": 4, "score": 1.0, "label": "Stable (2 - 4 Years)" },
            { "min": 1, "max": 2, "score": 0.5, "label": "Recent (1 - 2 Years)" },
            { "max": 1, "score": 0.25, "label": "New (< 1 Year)" }
          ]
        }
      }
    }
  }
}
