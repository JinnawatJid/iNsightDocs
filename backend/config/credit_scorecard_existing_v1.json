          ]
        },
        {
          "key": "turnover_speed",
          "label": "สัดส่วนยอดซื้อต่อระยะเวลาเครดิตที่ขอ",
          "weight": 21,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "เร็ว (>= 1.5)"
            },
            {
              "min": 0.9,
              "max": 1.5,
              "score": 1.5,
              "label": "ปกติ (0.9-1.5)"
            },
            {
              "min": 0.5,
              "max": 0.9,
              "score": 1,
              "label": "ช้า (0.5-0.9)"
            },
            {
              "max": 0.5,
              "score": 0.5,
              "label": "ช้ามาก (< 0.5)"
            }
          ]
        },
        {
          "key": "purchase_trend",
          "label": "แนวโน้มการซื้อ (Slope)",
          "weight": 43.8,
          "rules": [
            {
              "min": 16008.34,
              "score": 2,
              "label": "แนวโน้มขาขึ้นอย่างมาก (> 16k)"
            },
            {
              "min": 205.52,
              "max": 16008.34,
              "score": 1.5,
              "label": "แนวโน้มขาขึ้น (200 - 16k)"
            },
            {
              "min": -0.01,
              "max": 205.52,
              "score": 1,
              "label": "คงที่"
            },
            {
              "min": -4654.54,
              "max": -0.01,
              "score": 0.5,
              "label": "แนวโน้มขาลง"
            },
            {
              "max": -4654.54,
              "score": 0.25,
              "label": "แนวโน้มขาลงอย่างมาก"
            }
          ]
        },
        {
          "key": "customer_duration",
          "label": "ระยะเวลาเป็นลูกค้า",
          "weight": 12,
          "rules": [
            {
              "min": 7,
              "score": 2,
              "label": "ระยะยาว (> 7 ปี)"
            },
            {
              "min": 4,
              "max": 7,
              "score": 1.5,
              "label": "ระยะกลาง (4-7 ปี)"
            },
            {
              "min": 2,
              "max": 4,
              "score": 1,
              "label": "ระยะสั้น (2-4 ปี)"
            },
            {
              "min": 1,
              "max": 2,
              "score": 0.5,
              "label": "ใหม่ (1-2 ปี)"
            },
            {
              "max": 1,
              "score": 0.25,
              "label": "ใหม่มาก (< 1 ปี)"
            }
          ]
        },
        {
          "key": "wadl",
          "label": "ระยะเวลาการจ่ายเลท (WADL)",
          "weight": 19.8,
          "rules": [
            {
              "max": 1e-06,
              "score": 2,
              "label": "ดีเลิศ (0 วัน)"
            },
            {
              "min": 1e-06,
              "max": 5.000001,
              "score": 1.5,
              "label": "ดีเยี่ยม (<= 5 วัน)"
            },
            {
              "min": 5.000001,
              "max": 10.000001,
              "score": 1,
              "label": "ดี (5-10 วัน)"
            },
            {
              "min": 10.000001,
              "max": 15.000001,
              "score": 0.5,
              "label": "พอใช้ (10-15 วัน)"
            },
            {
              "min": 15.000001,
              "score": 0,
              "label": "แย่ (> 15 วัน)"
            }
          ]
        }
      ]
    }
  }
}