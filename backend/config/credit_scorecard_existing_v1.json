{
  "version": "1.1",
  "name": "Existing Customer Scorecard",
  "description": "Scorecard logic for Existing Customers with WADL factor",
  "limitExponent": 2,
  "size_definitions": [
    "S",
    "M",
    "L"
  ],
  "grade_definitions": [
    "D",
    "C",
    "B",
    "B+",
    "A",
    "A+"
  ],
  "components": {
    "c1": {
      "name": "Company Strength",
      "factors": [
        {
          "key": "years_in_business",
          "label": "ระยะเวลาธุรกิจ",
          "weight": 4,
          "rules": [
            {
              "min": 10,
              "score": 2,
              "label": "Established (> 10 Years)"
            },
            {
              "min": 5,
              "max": 10,
              "score": 1.5,
              "label": "Stable (5-10 Years)"
            },
            {
              "min": 3,
              "max": 5,
              "score": 1,
              "label": "Growing (3-5 Years)"
            },
            {
              "min": 1,
              "max": 3,
              "score": 0.5,
              "label": "New (1-3 Years)"
            },
            {
              "max": 1,
              "score": 0.25,
              "label": "Startup (< 1 Year)"
            }
          ]
        },
        {
          "key": "leverage",
          "label": "สัดส่วนเครดิตที่ขอต่อทุนจดทะเบียน",
          "weight": 13.4,
          "rules": [
            {
              "max": 0.51,
              "score": 2,
              "label": "Very Low Risk (<= 0.5)"
            },
            {
              "min": 0.51,
              "max": 0.9,
              "score": 1.5,
              "label": "Low Risk (0.5-0.9)"
            },
            {
              "min": 0.9,
              "max": 1.5,
              "score": 1,
              "label": "Medium Risk (0.9-1.5)"
            },
            {
              "min": 1.5,
              "max": 1.99,
              "score": 0.5,
              "label": "High Risk (1.5-1.99)"
            },
            {
              "min": 1.99,
              "score": 0.25,
              "label": "Very High Risk (> 1.99)"
            }
          ]
        },
        {
          "key": "asset_ownership",
          "label": "กรรมสิทธิ์ทรัพย์สิน",
          "weight": 10,
          "rules": [
            {
              "match": [
                "ตนเอง",
                "Own"
              ],
              "score": 2,
              "label": "Owned (Self)"
            },
            {
              "match": [
                "ญาติ",
                "บิดามารดา",
                "Relative",
                "Parents"
              ],
              "score": 1.5,
              "label": "Owned (Family)"
            },
            {
              "match": [
                "เช่า",
                "Rent"
              ],
              "score": 1,
              "label": "Rented"
            },
            {
              "default": true,
              "score": 1,
              "label": "Unknown/Other"
            }
          ]
        }
      ]
    },
    "c2": {
      "name": "Financial Status",
      "factors": [
        {
          "key": "de_ratio",
          "label": "อัตราการส่วนหนี้สินรวม ต่อส่วนของผู้ถือหุ้น",
          "weight": 11,
          "condition": "isCompany",
          "rules": [
            {
              "max": 1.01,
              "score": 2,
              "label": "Excellent (<= 1.0)"
            },
            {
              "min": 1.01,
              "max": 1.5,
              "score": 1.6,
              "label": "Good (1.0-1.5)"
            },
            {
              "min": 1.5,
              "max": 2,
              "score": 1.2,
              "label": "Fair (1.5-2.0)"
            },
            {
              "min": 2,
              "max": 3,
              "score": 1,
              "label": "Poor (2.0-3.0)"
            },
            {
              "min": 3,
              "score": 0,
              "label": "Critical (> 3.0)"
            }
          ]
        },
        {
          "key": "inventory_turnover",
          "label": "อัตราการหมุนเวียนของสินค้าคงเหลือ",
          "weight": 2.8,
          "rules": [
            {
              "min": 12,
              "score": 2,
              "label": "High (> 12)"
            },
            {
              "min": 8,
              "max": 12,
              "score": 1.5,
              "label": "Good (8-12)"
            },
            {
              "min": 6,
              "max": 8,
              "score": 1,
              "label": "Average (6-8)"
            },
            {
              "min": 4,
              "max": 6,
              "score": 0.5,
              "label": "Low (4-6)"
            },
            {
              "max": 4,
              "score": 0,
              "label": "Very Low (< 4)"
            }
          ],
          "condition": "isCompany"
        },
        {
          "key": "dscr",
          "label": "ความสามารถในการชำระหนี้ (DSCR)",
          "weight": 7.2,
          "condition": "isCompany",
          "rules": [
            {
              "min": 0.5,
              "score": 2,
              "label": "Strong (>= 0.5)"
            },
            {
              "min": 0.4,
              "max": 0.5,
              "score": 1.5,
              "label": "Good (0.4-0.5)"
            },
            {
              "min": 0.33,
              "max": 0.4,
              "score": 1,
              "label": "Fair (0.33-0.4)"
            },
            {
              "min": 0.25,
              "max": 0.33,
              "score": 0.5,
              "label": "Weak (0.25-0.33)"
            },
            {
              "max": 0.25,
              "score": 0,
              "label": "Critical (< 0.25)"
            }
          ]
        }
      ]
    },
    "c3": {
      "name": "Purchase Behavior",
      "factors": [
        {
          "key": "revenue_capital_ratio",
          "label": "สัดส่วนรายได้ต่อทุนจดทะเบียน",
          "weight": 15,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "Excellent (>= 1.5)"
            },
            {
              "min": 1,
              "max": 1.5,
              "score": 1.5,
              "label": "Good (1.0-1.5)"
            },
            {
              "min": 0.6,
              "max": 1,
              "score": 1,
              "label": "Fair (0.6-1.0)"
            },
            {
              "min": 0.26,
              "max": 0.6,
              "score": 0.5,
              "label": "Poor (0.26-0.6)"
            },
            {
              "max": 0.26,
              "score": 0.25,
              "label": "Critical (< 0.26)"
            }
          ]
        },
        {
          "key": "capacity_check",
          "label": "สัดส่วนยอดซื้อเฉลี่ย ย้อนหลัง 6 เดือนต่อเครดิตที่ขอ",
          "weight": 40,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "High Capacity (>= 1.5)"
            },
            {
              "min": 0.99,
              "max": 1.5,
              "score": 1.5,
              "label": "Good Capacity (1.0-1.5)"
            },
            {
              "min": 0.59,
              "max": 0.99,
              "score": 1,
              "label": "Moderate Capacity (0.6-1.0)"
            },
            {
              "min": 0.25,
              "max": 0.59,
              "score": 0.5,
              "label": "Low Capacity (0.25-0.6)"
            },
            {
              "max": 0.25,
              "score": 0.25,
              "label": "Very Low Capacity (< 0.25)"
            }
          ]
        },
        {
          "key": "turnover_speed",
          "label": "สัดส่วนยอดซื้อต่อระยะเวลาเครดิตที่ขอ",
          "weight": 21,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "Fast (>= 1.5)"
            },
            {
              "min": 0.9,
              "max": 1.5,
              "score": 1.5,
              "label": "Normal (0.9-1.5)"
            },
            {
              "min": 0.5,
              "max": 0.9,
              "score": 1,
              "label": "Slow (0.5-0.9)"
            },
            {
              "max": 0.5,
              "score": 0.5,
              "label": "Very Slow (< 0.5)"
            }
          ]
        },
        {
          "key": "purchase_trend",
          "label": "แนวโน้มการซื้อ (Slope)",
          "weight": 43.8,
          "rules": [
            {
              "min": 16008.34,
              "score": 2,
              "label": "Strong Uptrend (> 16k)"
            },
            {
              "min": 205.52,
              "max": 16008.34,
              "score": 1.5,
              "label": "Uptrend (200 - 16k)"
            },
            {
              "min": -0.01,
              "max": 205.52,
              "score": 1,
              "label": "Stable (Flat)"
            },
            {
              "min": -4654.54,
              "max": -0.01,
              "score": 0.5,
              "label": "Downtrend"
            },
            {
              "max": -4654.54,
              "score": 0.25,
              "label": "Strong Downtrend"
            }
          ]
        },
        {
          "key": "customer_duration",
          "label": "ระยะเวลาเป็นลูกค้า",
          "weight": 12,
          "rules": [
            {
              "min": 7,
              "score": 2,
              "label": "Long-term (> 7 Years)"
            },
            {
              "min": 4,
              "max": 7,
              "score": 1.5,
              "label": "Mid-term (4-7 Years)"
            },
            {
              "min": 2,
              "max": 4,
              "score": 1,
              "label": "Short-term (2-4 Years)"
            },
            {
              "min": 1,
              "max": 2,
              "score": 0.5,
              "label": "New (1-2 Years)"
            },
            {
              "max": 1,
              "score": 0.25,
              "label": "Brand New (< 1 Year)"
            }
          ]
        },
        {
          "key": "wadl",
          "label": "ระยะเวลาการจ่ายเลท (WADL)",
          "weight": 19.8,
          "rules": [
            {
              "max": 0.000001,
              "score": 2,
              "label": "Perfect (0 Days)"
            },
            {
              "min": 0.000001,
              "max": 5.000001,
              "score": 1.5,
              "label": "Excellent (<= 5 Days)"
            },
            {
              "min": 5.000001,
              "max": 10.000001,
              "score": 1,
              "label": "Good (5-10 Days)"
            },
            {
              "min": 10.000001,
              "max": 15.000001,
              "score": 0.5,
              "label": "Fair (10-15 Days)"
            },
            {
              "min": 15.000001,
              "score": 0,
              "label": "Poor (> 15 Days)"
            }
          ]
        }
      ]
    }
  }
}