{
  "version": "1.1",
  "name": "Existing Customer Scorecard",
  "description": "Scorecard logic for Existing Customers with WADL factor",
  "limitExponent": 0.5,
  "size_definitions": [
    "S",
    "M",
    "L"
  ],
  "grade_definitions": [
    "D",
    "C",
    "B",
    "B+",
    "A",
    "A+"
  ],
  "components": {
    "c1": {
      "name": "Company Strength",
      "factors": [
        {
          "key": "years_in_business",
          "label": "ระยะเวลาธุรกิจ",
          "weight": 5,
          "rules": [
            {
              "min": 10,
              "score": 2,
              "label": "ดำเนินกิจการมานาน (> 10 ปี)"
            },
            {
              "min": 5,
              "max": 10,
              "score": 1.5,
              "label": "มั่นคง (5-10 ปี)"
            },
            {
              "min": 3,
              "max": 5,
              "score": 1,
              "label": "กำลังเติบโต (3-5 ปี)"
            },
            {
              "min": 1,
              "max": 3,
              "score": 0.5,
              "label": "เริ่มกิจการใหม่ (1-3 ปี)"
            },
            {
              "max": 1,
              "score": 0.25,
              "label": "กิจการใหม่มาก (< 1 ปี)"
            }
          ]
        },
        {
          "key": "leverage",
          "label": "สัดส่วนเครดิตที่ขอต่อทุนจดทะเบียน",
          "weight": 12.4,
          "rules": [
            {
              "max": 0.51,
              "score": 2,
              "label": "ความเสี่ยงต่ำมาก (<= 0.5)"
            },
            {
              "min": 0.51,
              "max": 0.9,
              "score": 1.5,
              "label": "ความเสี่ยงต่ำ (0.5-0.9)"
            },
            {
              "min": 0.9,
              "max": 1.5,
              "score": 1,
              "label": "ความเสี่ยงปานกลาง (0.9-1.5)"
            },
            {
              "min": 1.5,
              "max": 1.99,
              "score": 0.5,
              "label": "ความเสี่ยงสูง (1.5-1.99)"
            },
            {
              "min": 1.99,
              "score": 0.25,
              "label": "ความเสี่ยงสูงมาก (> 1.99)"
            }
          ]
        },
        {
          "key": "asset_ownership",
          "label": "กรรมสิทธิ์ทรัพย์สิน",
          "weight": 10,
          "rules": [
            {
              "match": [
                "ตนเอง",
                "Own"
              ],
              "score": 2,
              "label": "เป็นเจ้าของ (ตนเอง)"
            },
            {
              "match": [
                "ญาติ",
                "บิดามารดา",
                "Relative",
                "Parents"
              ],
              "score": 1.5,
              "label": "เป็นเจ้าของ (ครอบครัว)"
            },
            {
              "match": [
                "เช่า",
                "Rent"
              ],
              "score": 1,
              "label": "เช่า"
            },
            {
              "default": true,
              "score": 1,
              "label": "ไม่ระบุ/อื่นๆ"
            }
          ]
        }
      ]
    },
    "c2": {
      "name": "Financial Status",
      "factors": [
        {
          "key": "de_ratio",
          "label": "อัตราการส่วนหนี้สินรวม ต่อส่วนของผู้ถือหุ้น",
          "weight": 11,
          "condition": "isCompany",
          "rules": [
            {
              "max": 1.01,
              "score": 2,
              "label": "ดีเยี่ยม (<= 1.0)"
            },
            {
              "min": 1.01,
              "max": 1.5,
              "score": 1.6,
              "label": "ดี (1.0-1.5)"
            },
            {
              "min": 1.5,
              "max": 2,
              "score": 1.2,
              "label": "พอใช้ (1.5-2.0)"
            },
            {
              "min": 2,
              "max": 3,
              "score": 1,
              "label": "แย่ (2.0-3.0)"
            },
            {
              "min": 3,
              "score": 0,
              "label": "วิกฤต (> 3.0)"
            }
          ]
        },
        {
          "key": "inventory_turnover",
          "label": "อัตราการหมุนเวียนของสินค้าคงเหลือ",
          "weight": 2.8,
          "rules": [
            {
              "min": 12,
              "score": 2,
              "label": "สูง (> 12)"
            },
            {
              "min": 8,
              "max": 12,
              "score": 1.5,
              "label": "ดี (8-12)"
            },
            {
              "min": 6,
              "max": 8,
              "score": 1,
              "label": "ปานกลาง (6-8)"
            },
            {
              "min": 4,
              "max": 6,
              "score": 0.5,
              "label": "ต่ำ (4-6)"
            },
            {
              "max": 4,
              "score": 0,
              "label": "ต่ำมาก (< 4)"
            }
          ],
          "condition": "isCompany"
        },
        {
          "key": "dscr",
          "label": "ความสามารถในการชำระหนี้ (DSCR)",
          "weight": 7.2,
          "condition": "isCompany",
          "rules": [
            {
              "min": 0.5,
              "score": 2,
              "label": "แข็งแกร่ง (>= 0.5)"
            },
            {
              "min": 0.4,
              "max": 0.5,
              "score": 1.5,
              "label": "ดี (0.4-0.5)"
            },
            {
              "min": 0.33,
              "max": 0.4,
              "score": 1,
              "label": "พอใช้ (0.33-0.4)"
            },
            {
              "min": 0.25,
              "max": 0.33,
              "score": 0.5,
              "label": "อ่อนแอ (0.25-0.33)"
            },
            {
              "max": 0.25,
              "score": 0,
              "label": "วิกฤต (< 0.25)"
            }
          ]
        }
      ]
    },
    "c3": {
      "name": "Purchase Behavior",
      "factors": [
        {
          "key": "revenue_capital_ratio",
          "label": "สัดส่วนรายได้ต่อทุนจดทะเบียน",
          "weight": 15,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "ดีเยี่ยม (>= 1.5)"
            },
            {
              "min": 1,
              "max": 1.5,
              "score": 1.5,
              "label": "ดี (1.0-1.5)"
            },
            {
              "min": 0.6,
              "max": 1,
              "score": 1,
              "label": "พอใช้ (0.6-1.0)"
            },
            {
              "min": 0.26,
              "max": 0.6,
              "score": 0.5,
              "label": "แย่ (0.26-0.6)"
            },
            {
              "max": 0.26,
              "score": 0.25,
              "label": "วิกฤต (< 0.26)"
            }
          ]
        },
        {
          "key": "capacity_check",
          "label": "สัดส่วนยอดซื้อเฉลี่ย ย้อนหลัง 6 เดือนต่อเครดิตที่ขอ",
          "weight": 40,
          "rules": [
            {
              "min": 1.5,
              "score": 2,
              "label": "ความสามารถสูง (>= 1.5)"
            },
            {
              "min": 0.99,
              "max": 1.5,
              "score": 1.5,
              "label": "ความสามารถดี (1.0-1.5)"
            },
            {
              "min": 0.59,
              "max": 0.99,
              "score": 1,
              "label": "ความสามารถปานกลาง (0.6-1.0)"
            },
            {
              "min": 0.25,
              "max": 0.59,
              "score": 0.5,
              "label": "ความสามารถต่ำ (0.25-0.6)"
            },
            {
              "max": 0.25,
              "score": 0.25,
              "label": "ความสามารถต่ำมาก (< 0.25)"
