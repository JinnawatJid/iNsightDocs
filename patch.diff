const getExposureForPhase = (index) => {
  if (!store.transactionData.projectPhasing) return 0;

  // Create timeline of events up to this phase to calculate running exposure
  const events = [];
  store.transactionData.projectPhasing.forEach((p, i) => {
    const amt = parseFloat(String(p.amount || '0').replace(/,/g, '')) || 0;
    if (amt > 0) {
      if (p.billingDate) {
        events.push({ time: parseDate(p.billingDate), type: 'add', amount: amt, idx: i });
      }
      if (p.paymentDate) {
        events.push({ time: parseDate(p.paymentDate), type: 'sub', amount: amt, idx: i });
      }
    }
  });

  // Sort events chronologically
  // If time is the same, process 'add' (billing) before 'sub' (payment) to show worst-case exposure
  events.sort((a, b) => {
    if (a.time === null) return 1;
    if (b.time === null) return -1;
    if (a.time !== b.time) return a.time - b.time;
    if (a.type !== b.type) return a.type === 'add' ? -1 : 1;
    return 0;
  });

  let currentExposure = 0;
  let phaseExposure = 0;

  // Calculate running exposure until we hit the billing date of the target phase
  const targetPhase = store.transactionData.projectPhasing[index];
  const targetTime = parseDate(targetPhase.billingDate);

  for (const ev of events) {
    if (ev.time !== null) {
      if (ev.type === 'add') currentExposure += ev.amount;
      if (ev.type === 'sub') currentExposure -= ev.amount;

      // We want to capture the exposure AT the time of this phase's billing
      if (ev.idx === index && ev.type === 'add') {
         phaseExposure = currentExposure;
      }
    }
  }

  // If no billing date set, just show 0 or amount?
  // Let's fallback to amount if no dates are set, but if dates are set use calculated phaseExposure
  if (!targetTime) return 0;

  return Math.max(0, phaseExposure);
};

